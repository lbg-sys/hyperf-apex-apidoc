{
    "name": "hyperf-apex/apidoc",
    "description": "Apex OpenAPI 3.1 documentation generator for Hyperf",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "hyperf",
        "swoole",
        "apex",
        "openapi"
    ],
    "homepage": "https://github.com/lbg-sys/hyperf-apex-apidoc",
    "support": {
        "issues": "https://github.com/lbg-sys/hyperf-apex-apidoc/issues",
        "source": "https://github.com/lbg-sys/hyperf-apex-apidoc"
    },
    "authors": [
        {
            "name": "lbg-sys",
            "homepage": "https://github.com/lbg-sys"
        }
    ],
    "require": {
        "php": ">=8.4",
        "hyperf-apex/core": "^0.1",
        "symfony/yaml": "^7.4",
        "zircote/swagger-php": "^6.12"
    },
    "autoload": {
        "psr-4": {
            "Hyperf\\Apex\\ApiDoc\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev",
            "dev-main": "0.1.x-dev"
        },
        "hyperf": {
            "config": "Hyperf\\Apex\\ApiDoc\\ConfigProvider"
        }
    }
}
